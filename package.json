{
  "name": "akalmesin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "post:new": "node scripts/post-new.mjs",
    "review:build": "node scripts/review.mjs build",
    "review:serve": "node scripts/review-serve.mjs",
    "review:apply": "node scripts/review.mjs apply",
    "copy:review": "node scripts/copy-review.mjs",
    "copy:record": "node scripts/copy-record.mjs",
    "approve": "node scripts/approve.mjs",
    "design:build": "node scripts/design-build.mjs",
    "design:check": "node scripts/design-check.mjs",
    "export": "node scripts/export.mjs",
    "schedule": "node scripts/schedule.mjs",
    "test": "node --test tests/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "reel:build": "node scripts/reel/render.mjs",
    "reel:check": "node scripts/reel/check.mjs",
    "instagram:growth": "node --disable-warning=ExperimentalWarning scripts/instagram-growth.mjs",
    "test:instagram-growth": "node --disable-warning=ExperimentalWarning --test tests/instagram-growth/*.test.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.62.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5"
