{
  "brand": "akalmesin",
  "source": {
    "sheets": [
      "brand/references/design-values-1-typography.png",
      "brand/references/design-values-2-color-treatment.png",
      "brand/references/design-values-3-spacing-layout.png"
    ],
    "note": "owner-measured 2026-10-28; no Figma. These three sheets are the only source of truth. All px values are at 1080x1350."
  },
  "canvas": {
    "width": 1080,
    "height": 1350
  },
  "color": {
    "ink": {
      "value": "#000000",
      "use": "primary text, header divider, Quote header"
    },
    "editorial-gray": {
      "value": "#EEEEEE",
      "use": "Main/Detail backgrounds, quote statement text and quote mark"
    },
    "reversed-text": {
      "value": "#FFFFFF",
      "use": "author, author role, photo credit"
    },
    "page-bg": {
      "value": "#0A0A0F",
      "use": "dark mode (t94u): Main/Detail background"
    },
    "text-primary": {
      "value": "#F2F2F5",
      "use": "headline, detail body"
    },
    "text-secondary": {
      "value": "#B4B4BE",
      "use": "summary, masthead category"
    },
    "photo-hairline": {
      "value": "rgba(255,255,255,0.12)",
      "width": 1,
      "use": "1px line on the photo top edge so it separates from the dark page"
    },
    "bold-gradient": {
      "value": "linear-gradient(90deg, #F2F2F5, #4E4FEB)",
      "from": "#F2F2F5",
      "to": "#4E4FEB",
      "angle": 90,
      "use": "bold phrase in detail body (owner t96u). Text is 40 px bold on the 1080 canvas (large text); contrast on #0A0A0F runs 17.68:1 to 3.43:1 at the blue end (passes the 3:1 large-text bar only)"
    }
  },
  "overlay": {
    "quote": {
      "type": "linear",
      "direction": "to bottom",
      "opacity": 1,
      "stops": [
        {
          "position": 0,
          "color": "#D9D9D9",
          "alpha": 0
        },
        {
          "position": 1,
          "color": "#000000",
          "alpha": 1
        }
      ]
    }
  },
  "font": {
